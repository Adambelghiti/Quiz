#!/usr/bin/env sh
# Wrapper script generated by maven-wrapper 3.5.0
export MAVEN_HOME=$MAVEN_HOME
if [ -z "$MAVEN_HOME" ]; then
  if [ -f "./.mvn/wrapper/maven-wrapper.jar" ]; then
    MAVEN_HOME=.
  else
    echo 'maven wrapper jar not found' >&2; exit 1
  fi
fi
exec java -jar "$MAVEN_HOME/.mvn/wrapper/maven-wrapper.jar" "${@}"